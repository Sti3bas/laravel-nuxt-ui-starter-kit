{
    "name": "laravel-nuxt-ui-starter-kit",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "types:check": "vue-tsc --noEmit",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "check": "eslint . && prettier --check resources/",
        "check:fix": "eslint . --fix && prettier --write resources/"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@laravel/vite-plugin-wayfinder": "^0.1.10",
        "@types/node": "^22.20.4",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.11.1",
        "prettier": "^3.9.9",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript-eslint": "^8.70.1",
        "vue-tsc": "^3.3.11"
    },
    "dependencies": {
        "@inertiajs/vite": "^3.7.1",
        "@inertiajs/vue3": "^3.7.1",
        "@laravel/passkeys": "^0.4.0",
        "@lucide/vue": "^1.48.0",
        "@nuxt/ui": "^4.11.2",
        "@tailwindcss/vite": "^4.3.3",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.5",
        "laravel-vite-plugin": "^3.2.0",
        "reka-ui": "^2.10.5",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "typescript": "^6.0.3",
        "vite": "^8.3.1",
        "vue": "^3.5.43",
        "zod": "^4.6.5"
    },
    "optionalDependencies": {
        "@rolldown/binding-linux-x64-gnu": "~1.2.9",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
        "lightningcss-linux-x64-gnu": "^1.33.0"
    }
